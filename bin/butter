#!/usr/bin/env node

/**
 * ButterStack CLI (butter)
 * Fast, scriptable, zero-dependency command line interface for the ButterStack game development pipeline.
 */

const http = require("http");
const https = require("https");
const crypto = require("crypto");
const fs = require("fs");
const path = require("path");
const os = require("os");
const { spawn } = require("child_process");

const CONFIG_DIR = path.join(os.homedir(), ".config", "butterstack");
const CREDS_FILE = path.join(CONFIG_DIR, "credentials.json");
const CONFIG_FILE = path.join(CONFIG_DIR, "config.json");

// Read once at startup so the User-Agent (and any future version reporting)
// always matches what's actually installed, rather than a string that has
// to be remembered and bumped by hand every release.
const PACKAGE_JSON = JSON.parse(fs.readFileSync(path.join(__dirname, "..", "package.json"), "utf-8"));
const CLI_VERSION = PACKAGE_JSON.version;

// ANSI Color Tokens (Aligned with ButterStack Design System)
const colors = {
  reset: "\x1b[0m",
  bold: "\x1b[1m",
  dim: "\x1b[2m",
  accent: "\x1b[38;2;56;189;248m",   // #38bdf8
  ok: "\x1b[38;2;74;222;128m",       // #4ade80
  warn: "\x1b[38;2;251;191;36m",     // #fbbf24
  err: "\x1b[38;2;248;113;113m",     // #f87171
  muted: "\x1b[38;2;148;163;184m",   // #94a3b8
  bgPanel: "\x1b[48;2;30;41;59m"     // #1e293b
};

// Set once in main() from the parsed top-level argv. Every command handler
// already takes its own `args`, but request()/getHost() are called from
// deep inside promise callbacks (e.g. the OAuth loopback handler) where
// threading `args` through every call site would be a much larger diff for
// no behavior difference -- there is exactly one CLI invocation per
// process, so one module-scoped copy of its args is unambiguous.
let cliArgs = {};

// Precedence: --host flag > BUTTERSTACK_HOST env > config.json (`butter
// auth login --host ...` persists here) > the host recorded in
// credentials.json at the last successful login > the production default.
// `--host` and `BUTTERSTACK_HOST` must always be fully honored, not merely
// parsed: a flag that's accepted on the command line but silently ignored
// is worse than no flag at all, because it lets a stored credential get
// attached to a request that the caller believed was going somewhere else
// entirely.
function getHost() {
  const flagHost = cliArgs && typeof cliArgs.host === "string" ? cliArgs.host : null;
  const storedCreds = loadCredentials();
  const resolved =
    flagHost ||
    process.env.BUTTERSTACK_HOST ||
    loadConfig().host ||
    (storedCreds && storedCreds.host) ||
    "https://www.butterstack.com";
  return resolved.replace(/\/$/, "");
}

function loadConfig() {
  if (fs.existsSync(CONFIG_FILE)) {
    try {
      return JSON.parse(fs.readFileSync(CONFIG_FILE, "utf-8"));
    } catch {
      return {};
    }
  }
  return {};
}

function saveConfig(cfg) {
  if (!fs.existsSync(CONFIG_DIR)) fs.mkdirSync(CONFIG_DIR, { recursive: true });
  fs.writeFileSync(CONFIG_FILE, JSON.stringify(cfg, null, 2));
}

function loadCredentials() {
  if (process.env.BUTTERSTACK_API_TOKEN) {
    return { token: process.env.BUTTERSTACK_API_TOKEN, source: "env" };
  }
  if (fs.existsSync(CREDS_FILE)) {
    try {
      const data = JSON.parse(fs.readFileSync(CREDS_FILE, "utf-8"));
      return { ...data, source: "file" };
    } catch {
      return null;
    }
  }
  return null;
}

function saveCredentials(creds) {
  if (!fs.existsSync(CONFIG_DIR)) fs.mkdirSync(CONFIG_DIR, { recursive: true });
  fs.writeFileSync(CREDS_FILE, JSON.stringify(creds, null, 2), { mode: 0o600 });
}

function clearCredentials() {
  if (fs.existsSync(CREDS_FILE)) fs.unlinkSync(CREDS_FILE);
}

function openBrowser(url) {
  // For non-interactive callers (tests, CI, containers). authLogin has already
  // printed the URL, so there is nothing to add here.
  if (process.env.BUTTERSTACK_NO_BROWSER) return;

  // spawn with an argument array, not a shell string built via exec(): the
  // URL is host-derived (--host / BUTTERSTACK_HOST / config), so a malicious
  // or malformed host value can never be interpreted by a shell, only
  // passed as a literal argv entry to the "open" helper -- and there's no
  // reason to interpolate into a shell command when an argv array costs
  // nothing.
  const start = process.platform === "darwin" ? "open" : process.platform === "win32" ? "start" : "xdg-open";
  const child = spawn(start, [url], { stdio: "ignore", shell: process.platform === "win32" });
  child.on("error", () => {
    console.log(`\n${colors.warn}! Could not automatically open browser.${colors.reset}`);
    console.log(`Please visit this URL to authenticate:\n  ${colors.accent}${url}${colors.reset}\n`);
  });
}

// `opts.noAuth` is used only by the login exchange call below: that request
// is *establishing* credentials for `host`, so it must never attach (or
// host-check against) whatever unrelated credential happens to already be
// on disk for a different host.
function request(method, endpoint, body = null, tokenOverride = null, opts = {}) {
  return new Promise((resolve, reject) => {
    const host = getHost();
    const creds = opts.noAuth ? null : loadCredentials();
    const token = opts.noAuth ? null : tokenOverride || (creds ? creds.token : null);

    // Refuse to silently send a stored credential to a host it wasn't
    // minted for. This is the core protection here, not just making --host
    // work: a credential file written by `butter auth login --host
    // https://www.butterstack.com` must never go out over a request that
    // resolved to some other host (e.g. a bare `butter` invocation that
    // fell back to a different default because an env var wasn't set, or a
    // flag was mistyped). Without this check, a host-resolution bug
    // anywhere upstream turns into a silent credential leak to the wrong
    // server instead of a loud, obvious error. An explicit --token override
    // bypasses this (the caller supplied that token directly, not the
    // file), and skipping when there IS no token at all is correct: an
    // unauthenticated request has nothing to leak.
    if (!opts.noAuth && !tokenOverride && token && creds && creds.source === "file" && creds.host) {
      const credHost = String(creds.host).replace(/\/$/, "");
      if (credHost !== host) {
        const err = new Error(
          `Refusing to send the stored credential (minted for ${credHost}) to ${host}. ` +
            `Pass --host ${credHost} (or unset BUTTERSTACK_HOST) to target the account this token belongs to, ` +
            `or run \`butter auth login --host ${host}\` to get a token for this host.`
        );
        err.code = "HOST_MISMATCH";
        reject(err);
        return;
      }
    }

    const url = new URL(endpoint.startsWith("http") ? endpoint : `${host}${endpoint}`);
    const isHttps = url.protocol === "https:";
    const client = isHttps ? https : http;

    const headers = {
      Accept: "application/json",
      "User-Agent": `butter-cli/${CLI_VERSION} (${os.platform()}; ${os.arch()})`
    };

    if (token) {
      headers["Authorization"] = `Bearer ${token}`;
    }

    let payload = null;
    if (body) {
      payload = typeof body === "string" ? body : JSON.stringify(body);
      headers["Content-Type"] = "application/json";
      headers["Content-Length"] = Buffer.byteLength(payload);
    }

    const req = client.request(
      url,
      {
        method,
        headers
      },
      (res) => {
        let data = "";
        res.on("data", (chunk) => (data += chunk));
        res.on("end", () => {
          let parsed;
          try {
            parsed = JSON.parse(data);
          } catch {
            parsed = data;
          }

          if (res.statusCode >= 200 && res.statusCode < 300) {
            resolve(parsed);
          } else {
            const err = new Error(
              parsed && parsed.message ? parsed.message : parsed && parsed.error ? parsed.error : `HTTP ${res.statusCode}`
            );
            err.statusCode = res.statusCode;
            err.response = parsed;
            reject(err);
          }
        });
      }
    );

    req.on("error", reject);
    if (payload) req.write(payload);
    req.end();
  });
}

// CLI Command Handlers
// Least-privilege presets for `butter auth login --scope <name>`. Named
// bundles cover the common "I only need X" case without making every
// caller memorize the raw permission strings; `--scope` also accepts a
// raw comma/space-separated permission list directly (passed through
// as-is, validated server-side against the CLI-eligible scope set).
const SCOPE_PRESETS = {
  "read-only": "read:projects read:tasks read:builds read:assets read:changes",
  full: "" // empty scope param -> server defaults to the full CLI set
};

async function authLogin(args) {
  const host = getHost();
  console.log(`${colors.accent}${colors.bold}ButterStack Authentication${colors.reset}`);
  console.log(`${colors.muted}Connecting to ${host}...${colors.reset}\n`);

  // No --scope -> omit the param entirely so the server keeps defaulting to
  // the full CLI set (unchanged behavior for a plain `butter auth login`).
  // A named preset or an explicit raw list narrows what gets requested --
  // e.g. a CI credential minted with `--scope read-only` never carries
  // write:assets/write:builds/write:tasks, which matters because a token
  // that ends up on a CI runner or in a script is more exposed than one
  // that lives only in a developer's own credential store.
  let requestedScope = null;
  if (args.scope) {
    requestedScope = SCOPE_PRESETS[args.scope] !== undefined ? SCOPE_PRESETS[args.scope] : args.scope.replace(/,/g, " ");
  }

  const codeVerifier = crypto.randomBytes(32).toString("hex");
  // digest("base64url") is the real syntax floor for this CLI: it needs
  // Node >=14.18.0. The "engines" field in package.json declares a higher
  // floor (>=18) as a support policy, not because anything below that
  // fails to run -- do not lower "engines" on the theory that this line
  // would still work on 14.x; the policy floor and the syntax floor are
  // tracked separately on purpose.
  const codeChallenge = crypto.createHash("sha256").update(codeVerifier).digest("base64url");
  const state = crypto.randomBytes(16).toString("hex");

  const server = http.createServer(async (req, res) => {
    const reqUrl = new URL(req.url || "/", `http://${req.headers.host}`);
    if (reqUrl.pathname !== "/callback") {
      res.writeHead(404);
      res.end("Not Found");
      return;
    }

    const returnedState = reqUrl.searchParams.get("state");
    const authCode = reqUrl.searchParams.get("code");

    if (returnedState !== state || !authCode) {
      res.writeHead(400, { "Content-Type": "text/html" });
      res.end("<h3>Authentication Failed: Invalid State</h3>");
      server.close();
      console.error(`${colors.err}✗ Authentication failed: State mismatch or missing code.${colors.reset}`);
      process.exit(1);
    }

    res.writeHead(200, { "Content-Type": "text/html" });
    res.end(`
      <!DOCTYPE html>
      <html>
        <head>
          <title>ButterStack Authorization</title>
          <style>
            body { background: #0f172a; color: #f8fafc; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; display: flex; height: 100vh; align-items: center; justify-content: center; margin: 0; }
            .card { background: #1e293b; padding: 2.5rem; border-radius: 16px; border: 1px solid #334155; text-align: center; max-width: 420px; box-shadow: 0 20px 30px rgba(0,0,0,0.4); }
            h2 { color: #38bdf8; margin: 0 0 0.5rem 0; font-size: 1.5rem; }
            p { color: #94a3b8; font-size: 0.95rem; line-height: 1.5; margin: 0.5rem 0; }
          </style>
        </head>
        <body>
          <div class="card">
            <h2>✓ Authentication Complete!</h2>
            <p>You have successfully authorized the ButterStack CLI.</p>
            <p>You can close this tab and return to your terminal.</p>
          </div>
        </body>
      </html>
    `);

    server.close();

    try {
      console.log(`${colors.muted}Exchanging authorization code for API token...${colors.reset}`);
      // noAuth: this call is establishing a credential for `host` -- it
      // must never attach (or get blocked by the host-binding check for)
      // some unrelated token that's already on disk for a different host.
      const exchange = await request(
        "POST",
        "/api/v1/cli/token_exchange",
        {
          code: authCode,
          code_verifier: codeVerifier,
          device_name: `${os.hostname()} (${os.platform()})`
        },
        null,
        { noAuth: true }
      );

      // The server is expected to derive the grant from what it bound at
      // GET time, not from anything the browser POSTs -- but the CLI
      // should still refuse to adopt a credential broader than what it
      // asked for rather than silently trusting the response, in case a
      // server-side bug, a proxy, or a browser extension ever alters the
      // exchange in flight. A credential granted more than requested is a
      // silent privilege escalation if it's just accepted and saved.
      if (requestedScope) {
        const requested = new Set(requestedScope.split(/\s+/).filter(Boolean));
        const granted = Array.isArray(exchange.scopes) ? exchange.scopes : [];
        const unexpected = granted.filter((s) => !requested.has(s));
        if (unexpected.length > 0) {
          console.error(
            `${colors.err}✗ Refusing to store this credential: it was granted ${unexpected.join(", ")}, ` +
              `which was not part of the requested scope (${[...requested].join(", ")}).${colors.reset}`
          );
          console.error(`${colors.err}This should never happen; please report it.${colors.reset}`);
          process.exit(1);
        }
      }

      saveCredentials({
        token: exchange.token,
        actor: exchange.actor,
        scopes: exchange.scopes,
        host: host,
        createdAt: exchange.created_at,
        expiresAt: exchange.expires_at
      });

      // Persist the host that was actually used for this login as the new
      // default, so a later invocation with neither --host nor
      // BUTTERSTACK_HOST still targets the account this token belongs to
      // instead of falling back to the production default.
      saveConfig({ ...loadConfig(), host });

      console.log(`${colors.ok}✓ Successfully authenticated as ${colors.bold}${exchange.actor.email}${colors.reset}`);
      console.log(`${colors.muted}Scopes: ${exchange.scopes.join(", ")}${colors.reset}`);
      if (exchange.expires_at) {
        console.log(`${colors.muted}Token expires ${new Date(exchange.expires_at).toLocaleDateString()} -- run ${colors.bold}butter auth login${colors.reset}${colors.muted} again after that to renew.${colors.reset}`);
      }
      if (!args.json) printMcpHint();
      console.log("");
      process.exit(0);
    } catch (err) {
      console.error(`${colors.err}✗ Token exchange failed: ${err.message}${colors.reset}`);
      process.exit(1);
    }
  });

  // Deliberately bound to the loopback interface, not "0.0.0.0" or left
  // unspecified: the OAuth callback carries the authorization code, and
  // binding to 127.0.0.1 means only a process on this same machine can
  // ever reach it. Widening this to listen on all interfaces would expose
  // the callback (and, transitively, the auth flow) to anything else on
  // the local network. Do not "fix" this to a wildcard bind.
  server.listen(0, "127.0.0.1", () => {
    const address = server.address();
    const port = address.port;
    let authUrl = `${host}/cli/auth?port=${port}&state=${state}&code_challenge=${codeChallenge}&client_name=ButterStack+CLI`;
    if (requestedScope) {
      authUrl += `&scope=${encodeURIComponent(requestedScope)}`;
    }

    if (process.env.BUTTERSTACK_NO_BROWSER) {
      console.log(`Visit this URL to authorize:`);
    } else {
      console.log(`Opening your browser for one-click authorization...`);
    }
    console.log(`${colors.dim}URL: ${authUrl}${colors.reset}\n`);
    openBrowser(authUrl);
  });
}

// Tokens minted via the browser loopback flow carry a 90-day expires_at --
// surface how much runway is left so a caller finds out from `whoami`,
// not from a 401 mid-script.
const RENEWAL_WARNING_WINDOW_DAYS = 7;

async function authWhoami(args) {
  const creds = loadCredentials();

  try {
    const ctx = await request("GET", "/api/v1/auth/context");
    if (args.json) {
      console.log(JSON.stringify({ ...ctx, expires_at: creds && creds.expiresAt }, null, 2));
      return;
    }
    console.log(`\n${colors.bold}ButterStack Identity:${colors.reset}`);
    console.log(`  Account ID: ${colors.accent}${ctx.account_id || "Personal"}${colors.reset}`);
    console.log(`  Actor Type: ${ctx.actor_type}`);
    console.log(`  Scopes:     ${colors.ok}${(ctx.scopes || []).join(", ")}${colors.reset}`);
    console.log(`  Host:       ${getHost()}`);

    if (creds && creds.expiresAt) {
      const daysLeft = Math.ceil((new Date(creds.expiresAt).getTime() - Date.now()) / (24 * 60 * 60 * 1000));
      console.log(`  Expires:    ${colors.muted}${new Date(creds.expiresAt).toLocaleDateString()} (${daysLeft} day${daysLeft === 1 ? "" : "s"})${colors.reset}`);
      if (daysLeft <= RENEWAL_WARNING_WINDOW_DAYS) {
        console.log(`  ${colors.warn}! Expiring soon -- run ${colors.bold}butter auth login${colors.reset}${colors.warn} to renew.${colors.reset}`);
      }
    }
    console.log("");
  } catch (err) {
    console.error(`${colors.err}✗ Not authenticated or invalid token: ${err.message}${colors.reset}`);
    console.error(`Run ${colors.bold}butter auth login${colors.reset} to log in.`);
    process.exit(1);
  }
}

async function authLogout() {
  clearCredentials();
  console.log(`${colors.ok}✓ Successfully logged out.${colors.reset}`);
}

async function projectsList(args) {
  try {
    const res = await request("GET", "/api/v1/projects");
    if (args.json) {
      console.log(JSON.stringify(res.projects, null, 2));
      return;
    }
    console.log(`\n${colors.bold}PROJECTS (${res.projects.length})${colors.reset}`);
    console.log("----------------------------------------------------------------------");
    res.projects.forEach((p) => {
      console.log(
        `  ${colors.bold}${p.id.toString().padEnd(6)}${colors.reset} ${colors.accent}${p.name.padEnd(25)}${colors.reset} [${p.project_type}] ${colors.muted}Tasks: ${p.tasks_count} | Builds: ${p.build_runs_count} | Assets: ${p.assets_count}${colors.reset}`
      );
    });
    console.log("");
  } catch (err) {
    console.error(`${colors.err}✗ Failed to list projects: ${err.message}${colors.reset}`);
    process.exit(1);
  }
}

async function projectsShow(args) {
  const projectId = args._[2];
  if (!projectId) {
    console.error(`${colors.err}✗ Usage: butter projects show <project_id>${colors.reset}`);
    process.exit(1);
  }

  try {
    const res = await request("GET", `/api/v1/projects/${projectId}`);
    if (args.json) {
      console.log(JSON.stringify(res, null, 2));
      return;
    }

    console.log(`\n${colors.bold}PROJECT ${res.id}${colors.reset}`);
    console.log("----------------------------------------------------------------------");
    console.log(`  Name:          ${colors.accent}${res.name || "-"}${colors.reset}`);
    console.log(`  Type:          ${res.project_type || "-"}`);
    console.log(`  Tasks:         ${res.tasks_count != null ? res.tasks_count : "-"}`);
    console.log(`  Builds:        ${res.build_runs_count != null ? res.build_runs_count : "-"}`);
    console.log(`  Assets:        ${res.assets_count != null ? res.assets_count : "-"}`);
    if (res.pending_assets_count != null) {
      console.log(`  Pending:       ${res.pending_assets_count} asset(s) awaiting approval`);
    }

    const b = res.latest_build;
    if (b) {
      const statusColor =
        b.status === "completed" ? colors.ok : b.status === "failed" ? colors.err : colors.warn;
      const parts = [b.id, `${statusColor}${b.status}${colors.reset}`];
      if (b.target_type) parts.push(b.target_type);
      if (b.commit_hash) parts.push(String(b.commit_hash).slice(0, 8));
      console.log(`  Latest build:  ${parts.join("  ")}`);
    } else {
      console.log(`  Latest build:  ${colors.muted}none${colors.reset}`);
    }
    console.log("");
  } catch (err) {
    console.error(`${colors.err}✗ Failed to show project: ${err.message}${colors.reset}`);
    process.exit(1);
  }
}

async function tasksList(args) {
  const projectId = args.project || loadConfig().defaultProject;
  if (!projectId) {
    console.error(`${colors.err}✗ Missing project ID. Use --project <id> or set default in config.${colors.reset}`);
    process.exit(1);
  }

  const query = new URLSearchParams();
  if (args.state) query.set("state", args.state);
  if (args.type) query.set("task_type", args.type);
  if (args.priority) query.set("priority", args.priority);
  if (args.assignee) query.set("assignee", args.assignee);
  if (args.limit) query.set("limit", args.limit);

  try {
    const res = await request("GET", `/api/v1/projects/${projectId}/tasks?${query.toString()}`);
    if (args.json) {
      console.log(JSON.stringify(res, null, 2));
      return;
    }
    console.log(`\n${colors.bold}TASKS for Project #${projectId} (${res.tasks.length})${colors.reset}`);
    console.log("----------------------------------------------------------------------");
    res.tasks.forEach((t) => {
      const stateColor = t.state === "completed" ? colors.ok : t.state === "blocked" ? colors.err : colors.warn;
      console.log(
        `  #${t.id.toString().padEnd(5)} ${stateColor}[${t.state}]${colors.reset} ${colors.accent}[${t.task_type || "task"}]${colors.reset} ${t.title} ${colors.muted}(${t.priority || "normal"})${colors.reset}`
      );
    });
    console.log("");
  } catch (err) {
    console.error(`${colors.err}✗ Failed to list tasks: ${err.message}${colors.reset}`);
    process.exit(1);
  }
}

async function tasksCreate(args) {
  const projectId = args.project || loadConfig().defaultProject;
  const title = args._[2];
  if (!projectId || !title) {
    console.error(`${colors.err}✗ Usage: butter tasks create "<title>" --project <id> [--type <type>] [--priority <priority>]${colors.reset}`);
    process.exit(1);
  }

  try {
    const res = await request("POST", `/api/v1/projects/${projectId}/tasks`, {
      task: {
        title: title,
        task_type: args.type || "chore",
        priority: args.priority || "medium",
        state: args.state || "to_do",
        description: args.description || "",
        assignee_handle: args.assignee || null
      }
    });

    if (args.json) {
      console.log(JSON.stringify(res, null, 2));
      return;
    }
    console.log(`${colors.ok}✓ Created Task #${res.id}:${colors.reset} ${colors.bold}${res.title}${colors.reset}`);
  } catch (err) {
    console.error(`${colors.err}✗ Failed to create task: ${err.message}${colors.reset}`);
    process.exit(1);
  }
}

async function buildsList(args) {
  const projectId = args.project || loadConfig().defaultProject;
  if (!projectId) {
    console.error(`${colors.err}✗ Missing project ID. Use --project <id>${colors.reset}`);
    process.exit(1);
  }

  const query = new URLSearchParams();
  if (args.status) query.set("status", args.status);
  if (args.type) query.set("build_type", args.type);
  if (args.limit) query.set("limit", args.limit || "10");

  try {
    const res = await request("GET", `/api/v1/projects/${projectId}/build_runs?${query.toString()}`);
    if (args.json) {
      console.log(JSON.stringify(res.build_runs, null, 2));
      return;
    }
    console.log(`\n${colors.bold}BUILDS for Project #${projectId} (${res.build_runs.length})${colors.reset}`);
    console.log("----------------------------------------------------------------------");
    res.build_runs.forEach((b) => {
      const statusColor = b.status === "completed" ? colors.ok : b.status === "failed" ? colors.err : colors.warn;
      console.log(
        `  Build #${b.id.toString().padEnd(5)} ${statusColor}[${b.status.toUpperCase()}]${colors.reset} ${b.build_type || "build"} ${colors.muted}${b.commit_hash ? `@${b.commit_hash}` : ""} (${b.duration ? b.duration + "s" : ""})${colors.reset}`
      );
    });
    console.log("");
  } catch (err) {
    console.error(`${colors.err}✗ Failed to list builds: ${err.message}${colors.reset}`);
    process.exit(1);
  }
}

async function buildsShow(args) {
  const projectId = args.project || loadConfig().defaultProject;
  const buildId = args._[2];
  if (!projectId || !buildId) {
    console.error(`${colors.err}✗ Usage: butter builds show <build_id> --project <id>${colors.reset}`);
    process.exit(1);
  }

  try {
    const res = await request("GET", `/api/v1/projects/${projectId}/build_runs/${buildId}`);
    if (args.json) {
      console.log(JSON.stringify(res, null, 2));
      return;
    }

    const statusColor =
      res.status === "completed" ? colors.ok : res.status === "failed" ? colors.err : colors.warn;
    console.log(`\n${colors.bold}BUILD ${res.id}${colors.reset}`);
    console.log("----------------------------------------------------------------------");
    console.log(`  Status:        ${statusColor}${String(res.status).toUpperCase()}${colors.reset}`);
    console.log(`  Overall:       ${res.overall_status || "-"}`);
    console.log(`  Job:           ${res.ci_job_name || "-"}`);
    console.log(`  Commit:        ${res.commit_hash || "-"}`);
    if (res.commit_hash) {
      console.log(`  Change:        ${colors.muted}butter changes show ${res.commit_hash} --project ${projectId}${colors.reset}`);
    }
    console.log(`  Type:          ${res.build_type || "-"}${res.target_type ? ` / ${res.target_type}` : ""}`);
    console.log(`  Duration:      ${res.duration != null ? `${res.duration}s` : "-"}`);
    console.log(`  Created:       ${res.created_at || "-"}`);

    // #1940: an investigation with no log to read cannot say anything useful,
    // so surface that here rather than leaving it to be inferred from a
    // vague diagnosis.
    if (res.log_available === false) {
      console.log(`  Build log:     ${colors.warn}not available${colors.reset}`);
      if (res.log_unavailable_reason) console.log(`                 ${colors.muted}${res.log_unavailable_reason}${colors.reset}`);
    } else if (res.log_available === true) {
      console.log(`  Build log:     ${colors.ok}available${colors.reset}`);
    }

    if (Array.isArray(res.steps) && res.steps.length) {
      console.log(`\n${colors.bold}  Steps:${colors.reset}`);
      res.steps.forEach((s) => {
        const c = s.status === "completed" ? colors.ok : s.status === "failed" ? colors.err : colors.warn;
        console.log(
          `    ${c}[${s.status}]${colors.reset} ${s.step_type}${s.message ? ` ${colors.muted}- ${s.message}${colors.reset}` : ""}`
        );
      });
    }

    // Three distinct cases, and conflating them is how #1938 stayed confusing:
    // an investigation exists; none has been run; or the server predates the
    // read path and cannot tell us either way. A server without the key must
    // not be reported as "no investigation" - that is the exact false negative
    // that sent people back to POSTing `investigate` to find out.
    if (res.investigation) {
      console.log("");
      printInvestigation(res.investigation);
    } else if (Object.prototype.hasOwnProperty.call(res, "investigation")) {
      console.log(`\n  ${colors.muted}No AI investigation has been run for this build.${colors.reset}`);
      console.log(`  ${colors.muted}Run: butter builds investigate ${res.id} --project ${projectId}${colors.reset}`);
    } else {
      console.log(`\n  ${colors.warn}This ButterStack server does not expose investigations on the build detail.${colors.reset}`);
      console.log(`  ${colors.muted}Try: butter builds investigation ${res.id} --project ${projectId}${colors.reset}`);
    }
    console.log("");
  } catch (err) {
    console.error(`${colors.err}✗ Failed to show build: ${err.message}${colors.reset}`);
    process.exit(1);
  }
}

function printInvestigation(inv) {
  const statusColor =
    inv.status === "completed" ? colors.ok : inv.status === "failed" ? colors.err : colors.warn;
  console.log(`${colors.bold}AI Failure Investigation:${colors.reset}`);
  console.log(`  Status:        ${statusColor}${inv.status}${colors.reset}`);

  if (inv.status === "pending" || inv.status === "running") {
    console.log(`  ${colors.muted}Still in flight. Re-read with \`butter builds investigation\` - do not`);
    console.log(`  re-run \`investigate\`, which starts a new paid analysis.${colors.reset}`);
    return;
  }

  if (inv.status === "failed") {
    console.log(`  Error:         ${colors.err}${inv.error_message || "unknown"}${colors.reset}`);
    return;
  }

  if (inv.diagnosis_category) {
    console.log(`  Category:      ${inv.diagnosis_category}${inv.severity ? ` (${inv.severity})` : ""}`);
  }
  if (inv.confidence) console.log(`  Confidence:    ${inv.confidence}`);
  if (inv.summary) console.log(`  Summary:       ${inv.summary}`);
  if (inv.diagnosis) console.log(`  Diagnosis:     ${inv.diagnosis}`);
  if (inv.suggested_fix) console.log(`  Fix:           ${colors.accent}${inv.suggested_fix}${colors.reset}`);

  // Attribution is printed only when the investigation actually made one.
  // "unattributed" is a real, common and correct answer -- a file that was
  // never submitted has no offending changelist and no culpable author.
  if (inv.attributed_changelist || inv.attributed_user_id) {
    console.log(
      `  Attributed:    ${inv.attributed_changelist ? `CL ${inv.attributed_changelist}` : ""}${
        inv.attributed_user_id ? ` (user ${inv.attributed_user_id})` : ""
      }`
    );
  } else {
    console.log(`  Attributed:    ${colors.muted}unattributed${colors.reset}`);
  }

  if (Array.isArray(inv.affected_files) && inv.affected_files.length) {
    console.log(`  Files:         ${inv.affected_files.join(", ")}`);
  }
  if (Array.isArray(inv.evidence) && inv.evidence.length) {
    console.log(`${colors.bold}  Evidence:${colors.reset}`);
    inv.evidence.forEach((e) => console.log(`    ${colors.muted}- ${e}${colors.reset}`));
  }
}

// Read-only counterpart to `investigate` (#1938). Before this existed, the
// only way to see a result was to POST investigate again, which spends
// credits and starts a fresh Bedrock run once the previous one has finished.
async function buildsInvestigation(args) {
  const projectId = args.project || loadConfig().defaultProject;
  const buildId = args._[2];
  if (!projectId || !buildId) {
    console.error(`${colors.err}✗ Usage: butter builds investigation <build_id> --project <id>${colors.reset}`);
    process.exit(1);
  }

  try {
    const res = await request("GET", `/api/v1/projects/${projectId}/build_runs/${buildId}/investigation`);
    if (args.json) {
      console.log(JSON.stringify(res, null, 2));
      return;
    }
    console.log("");
    printInvestigation(res);
    if (args.steps && Array.isArray(res.steps) && res.steps.length) {
      console.log(`\n${colors.bold}  Steps:${colors.reset}`);
      res.steps.forEach((s) => {
        console.log(`    ${colors.muted}${String(s.step).padStart(3)} ${s.step_type}${colors.reset}${s.content ? ` ${s.content}` : ""}`);
      });
    } else if (Array.isArray(res.steps) && res.steps.length) {
      console.log(`\n  ${colors.muted}${res.steps.length} step(s). Pass --steps to print the trail.${colors.reset}`);
    }
    console.log("");
  } catch (err) {
    if (err.statusCode === 404) {
      console.error(`${colors.warn}No investigation has been run for build ${buildId}.${colors.reset}`);
      console.error(`${colors.muted}Start one with: butter builds investigate ${buildId} --project ${projectId}${colors.reset}`);
      process.exit(1);
    }
    console.error(`${colors.err}✗ Failed to read investigation: ${err.message}${colors.reset}`);
    process.exit(1);
  }
}

async function buildsInvestigate(args) {
  const projectId = args.project || loadConfig().defaultProject;
  const buildId = args._[2];
  if (!projectId || !buildId) {
    console.error(`${colors.err}✗ Usage: butter builds investigate <build_id> --project <id>${colors.reset}`);
    process.exit(1);
  }

  try {
    if (!args.json) {
      console.log(`${colors.accent}Triggering AI Failure Investigation for Build #${buildId}...${colors.reset}`);
    }
    const res = await request("POST", `/api/v1/projects/${projectId}/build_runs/${buildId}/investigate`);
    if (args.json) {
      console.log(JSON.stringify(res, null, 2));
      return;
    }
    console.log("");
    printInvestigation(res);
    // An investigation runs asynchronously, so the POST almost always returns
    // `pending`. Point at the read path rather than letting the caller poll
    // by re-POSTing, which is what made this cost money to check on (#1938).
    if (res.status === "pending" || res.status === "running") {
      console.log(
        `\n  ${colors.muted}Check the result with: butter builds investigation ${buildId} --project ${projectId}${colors.reset}`
      );
    }
    console.log("");
  } catch (err) {
    console.error(`${colors.err}✗ Failed to investigate build: ${err.message}${colors.reset}`);
    process.exit(1);
  }
}

// -- Changes: commits and changelists across the git, Perforce and Lore rails --

// Friendly --source names mapped onto the API's source_type. Lore and
// Perforce share source_type "Changelist", so those two are split by
// identifier on this side: Lore changelists are namespaced "lore-<n>",
// Perforce ones are bare numbers. The raw API values are accepted as-is.
const CHANGE_SOURCES = {
  git: { sourceType: "GitCommit" },
  perforce: { sourceType: "Changelist", keep: (c) => c.source_type === "Changelist" && !String(c.identifier).startsWith("lore-") },
  lore: { sourceType: "Changelist", keep: (c) => c.source_type === "Changelist" && String(c.identifier).startsWith("lore-") },
  GitCommit: { sourceType: "GitCommit" },
  AssetCommit: { sourceType: "AssetCommit" },
  Changelist: { sourceType: "Changelist" }
};

function changeSourceLabel(c) {
  if (c.source_type === "GitCommit") return "git";
  if (c.source_type === "AssetCommit") return "asset";
  if (c.source_type === "Changelist") return String(c.identifier).startsWith("lore-") ? "lore" : "perforce";
  return c.source_type || "-";
}

// A BuildRun's commit_hash is not always a Change identifier verbatim: a
// Perforce build stores "p4-<n>" while its Change stores the bare "<n>".
// The identifier filter is exact and never validated, so passing "p4-207"
// through unchanged returns an empty list rather than an error.
function changeLookupFor(ref) {
  const m = /^p4-(\d+)$/.exec(ref);
  if (m) return { identifier: m[1], sourceType: "Changelist" };
  return { identifier: ref, sourceType: null };
}

function reportChangesError(action, err) {
  console.error(`${colors.err}✗ Failed to ${action}: ${err.message}${colors.reset}`);
  const body = err.response;
  if (err.statusCode === 403 && body && body.required_scope === "read:changes") {
    console.error(
      `${colors.muted}  This token does not carry read:changes. Tokens issued before the changes commands shipped never got it: run \`butter auth login\` again to reissue.${colors.reset}`
    );
  }
  process.exit(1);
}

async function changesList(args) {
  const projectId = args.project || loadConfig().defaultProject;
  if (!projectId) {
    console.error(`${colors.err}✗ Missing project ID. Use --project <id>${colors.reset}`);
    process.exit(1);
  }

  const query = new URLSearchParams();
  let keep = null;
  if (args.source) {
    const source = CHANGE_SOURCES[args.source];
    if (!source) {
      console.error(`${colors.err}✗ Unknown --source "${args.source}". Use lore, git, or perforce.${colors.reset}`);
      process.exit(1);
    }
    query.set("source_type", source.sourceType);
    keep = source.keep || null;
  }
  if (args.identifier) {
    const lookup = changeLookupFor(String(args.identifier));
    query.set("identifier", lookup.identifier);
    if (lookup.sourceType && !args.source) query.set("source_type", lookup.sourceType);
  }
  if (args.since) query.set("updated_since", args.since);
  if (args.orphaned) query.set("orphaned", "true");
  if (args.limit) query.set("limit", args.limit);
  // --after, not --cursor: `--cursor` is already the boolean client flag of
  // `butter mcp install`, so it can never carry a value.
  if (typeof args.after === "string") query.set("cursor", args.after);

  try {
    const res = await request("GET", `/api/v1/projects/${projectId}/changes?${query.toString()}`);
    const changes = keep ? res.changes.filter(keep) : res.changes;
    if (args.json) {
      // The whole envelope, not just the array: without pagination a script
      // has no next_cursor to fetch the page after this one.
      console.log(JSON.stringify({ changes, pagination: res.pagination }, null, 2));
      return;
    }
    console.log(`\n${colors.bold}CHANGES for Project #${projectId} (${changes.length})${colors.reset}`);
    console.log("----------------------------------------------------------------------");
    changes.forEach((c) => {
      const summary = String(c.description || "").split("\n")[0];
      const orphaned = c.orphaned_at ? ` ${colors.warn}(orphaned)${colors.reset}` : "";
      console.log(
        `  Change #${c.id.toString().padEnd(6)} ${colors.accent}[${changeSourceLabel(c)}]${colors.reset} ${c.display_identifier || c.identifier} ${colors.muted}${c.author || "-"}${colors.reset} ${summary}${orphaned}`
      );
    });
    if (res.pagination && res.pagination.has_more && res.pagination.next_cursor) {
      console.log(
        `\n  ${colors.muted}More: butter changes list --project ${projectId} --after ${res.pagination.next_cursor}${colors.reset}`
      );
    }
    console.log("");
  } catch (err) {
    reportChangesError("list changes", err);
  }
}

async function changesShow(args) {
  const projectId = args.project || loadConfig().defaultProject;
  const ref = args._[2] !== undefined ? String(args._[2]) : null;
  if (!projectId || !ref) {
    console.error(`${colors.err}✗ Usage: butter changes show <change_id|commit> --project <id>${colors.reset}`);
    process.exit(1);
  }

  try {
    // An all-digit ref is the change id that `changes list` prints. Anything
    // else is a commit reference (a git SHA, a build's p4-<n>, a lore-<n>),
    // resolved through the exact-match identifier filter first.
    let changeId = ref;
    if (!/^\d+$/.test(ref)) {
      const lookup = changeLookupFor(ref);
      const query = new URLSearchParams({ identifier: lookup.identifier, orphaned: "true" });
      if (lookup.sourceType) query.set("source_type", lookup.sourceType);
      const found = await request("GET", `/api/v1/projects/${projectId}/changes?${query.toString()}`);
      if (!found.changes || found.changes.length === 0) {
        console.error(`${colors.err}✗ No change with identifier "${lookup.identifier}" in project ${projectId}.${colors.reset}`);
        console.error(
          `${colors.muted}  The match is exact: use the full commit SHA, a Perforce build's p4-<n>, or lore-<n>. A bare Perforce changelist number is read as a change id; use: butter changes list --project ${projectId} --identifier <n>${colors.reset}`
        );
        process.exit(1);
      }
      changeId = found.changes[0].id;
    }

    const res = await request("GET", `/api/v1/projects/${projectId}/changes/${changeId}`);
    if (args.json) {
      console.log(JSON.stringify(res, null, 2));
      return;
    }

    console.log(`\n${colors.bold}CHANGE ${res.id}${colors.reset}`);
    console.log("----------------------------------------------------------------------");
    console.log(`  Identifier:    ${colors.accent}${res.identifier || "-"}${colors.reset}`);
    console.log(`  Source:        ${changeSourceLabel(res)} (${res.source_type || "-"})`);
    console.log(`  Author:        ${res.author || "-"}`);
    console.log(`  Timestamp:     ${res.timestamp || "-"}`);
    if (res.orphaned_at) {
      console.log(`  Orphaned:      ${colors.warn}${res.orphaned_at}${colors.reset}`);
    }
    if (res.files_available === false) {
      console.log(`  Files:         ${colors.muted}not available for this change${colors.reset}`);
    } else {
      console.log(`  Files:         ${res.file_count != null ? res.file_count : Array.isArray(res.files) ? res.files.length : "-"}`);
    }
    const a = res.approvals;
    if (a) {
      console.log(`  Approvals:     ${a.approved} approved, ${a.pending} pending, ${a.denied} denied, ${a.ignored} ignored`);
    }
    const tasks = Array.isArray(res.task_ids) && res.task_ids.length ? res.task_ids.map((id) => `#${id}`).join(", ") : "none";
    console.log(`  Tasks:         ${tasks}`);

    const b = res.latest_build;
    if (b) {
      const statusColor = b.status === "completed" ? colors.ok : b.status === "failed" ? colors.err : colors.warn;
      console.log(`  Latest build:  ${b.id}  ${statusColor}${b.status}${colors.reset}${b.ci_job_name ? `  ${b.ci_job_name}` : ""}`);
    } else {
      console.log(`  Latest build:  ${colors.muted}none${colors.reset}`);
    }

    if (res.description) {
      console.log(`\n${colors.bold}  Description:${colors.reset}`);
      String(res.description)
        .trimEnd()
        .split("\n")
        .forEach((line) => console.log(`    ${line}`));
    }

    if (Array.isArray(res.build_runs) && res.build_runs.length) {
      console.log(`\n${colors.bold}  Builds (${res.build_runs.length}):${colors.reset}`);
      res.build_runs.forEach((br) => {
        const c = br.status === "completed" ? colors.ok : br.status === "failed" ? colors.err : colors.warn;
        console.log(`    ${br.id} ${c}[${br.status}]${colors.reset} ${br.ci_job_name || ""} ${colors.muted}${br.commit_hash || ""}${colors.reset}`);
      });
    }

    if (Array.isArray(res.files) && res.files.length) {
      const shown = res.files.slice(0, 20);
      console.log(`\n${colors.bold}  Files (${res.files.length}):${colors.reset}`);
      shown.forEach((f) => console.log(`    ${colors.muted}${(f.action || "").padEnd(8)}${colors.reset} ${f.path || "-"}`));
      if (res.files.length > shown.length) {
        console.log(`    ${colors.muted}... and ${res.files.length - shown.length} more (use --json for all)${colors.reset}`);
      }
    }
    console.log("");
  } catch (err) {
    reportChangesError("show change", err);
  }
}

async function assetsList(args) {
  const projectId = args.project || loadConfig().defaultProject;
  if (!projectId) {
    console.error(`${colors.err}✗ Missing project ID. Use --project <id>${colors.reset}`);
    process.exit(1);
  }

  const query = new URLSearchParams();
  if (args.pending) query.set("pending_approval", "true");
  if (args.type) query.set("asset_type", args.type);
  if (args.limit) query.set("limit", args.limit || "20");

  try {
    const res = await request("GET", `/api/v1/projects/${projectId}/assets?${query.toString()}`);
    if (args.json) {
      console.log(JSON.stringify(res.assets, null, 2));
      return;
    }
    console.log(`\n${colors.bold}ASSETS for Project #${projectId} (${res.assets.length})${colors.reset}`);
    console.log("----------------------------------------------------------------------");
    res.assets.forEach((a) => {
      const statusColor = a.approval_status === "approved" ? colors.ok : a.approval_status === "denied" ? colors.err : colors.warn;
      console.log(
        `  ${a.id.substring(0, 8)} ${statusColor}[${a.approval_status}]${colors.reset} ${colors.accent}[${a.asset_type}]${colors.reset} ${a.name} ${colors.muted}(${a.depot_path || a.path})${colors.reset}`
      );
    });
    console.log("");
  } catch (err) {
    console.error(`${colors.err}✗ Failed to list assets: ${err.message}${colors.reset}`);
    process.exit(1);
  }
}

async function assetsApprove(args) {
  const projectId = args.project || loadConfig().defaultProject;
  const assetId = args._[2];
  if (!projectId || !assetId) {
    console.error(`${colors.err}✗ Usage: butter assets approve <asset_id> --project <id> [--comment <text>]${colors.reset}`);
    process.exit(1);
  }

  try {
    const res = await request("POST", `/api/v1/projects/${projectId}/assets/${assetId}/approvals`, {
      status: "approved",
      comments: args.comment || "Approved via ButterStack CLI"
    });
    if (args.json) {
      console.log(JSON.stringify(res, null, 2));
      return;
    }
    console.log(`${colors.ok}✓ Asset ${assetId} approved successfully.${colors.reset}`);
  } catch (err) {
    console.error(`${colors.err}✗ Failed to approve asset: ${err.message}${colors.reset}`);
    process.exit(1);
  }
}

async function assetsDeny(args) {
  const projectId = args.project || loadConfig().defaultProject;
  const assetId = args._[2];
  const reason = args.reason || args.comment || "Denied via ButterStack CLI";
  if (!projectId || !assetId) {
    console.error(`${colors.err}✗ Usage: butter assets deny <asset_id> --project <id> [--reason <text>]${colors.reset}`);
    process.exit(1);
  }

  try {
    const res = await request("POST", `/api/v1/projects/${projectId}/assets/${assetId}/approvals`, {
      status: "denied",
      comments: reason
    });
    if (args.json) {
      console.log(JSON.stringify(res, null, 2));
      return;
    }
    console.log(`${colors.warn}✓ Asset ${assetId} denied with feedback: "${reason}"${colors.reset}`);
  } catch (err) {
    console.error(`${colors.err}✗ Failed to deny asset: ${err.message}${colors.reset}`);
    process.exit(1);
  }
}

// -- MCP client configuration ------------------------------------------------
//
// The ButterStack MCP server (`npx -y butterstack-mcp`) reads the credential
// `butter auth login` writes, so login is step one of every MCP setup. The
// clients disagree on the config schema, and the Claude shape pasted into
// OpenCode makes OpenCode refuse to start, so each client's entry is built
// here and nowhere else.

const MCP_SERVER_NAME = "butterstack";
const MCP_PACKAGE = "butterstack-mcp";
const MCP_DOCS_URL = "https://butterstack.com/docs/guides/mcp";

function printMcpHint() {
  console.log(`\n${colors.bold}Connect your AI client to ButterStack:${colors.reset}`);
  console.log(`  Claude Code:  ${colors.accent}claude mcp add ${MCP_SERVER_NAME} -- npx -y ${MCP_PACKAGE}${colors.reset}`);
  console.log(
    `  OpenCode:     ${colors.accent}opencode mcp add ${MCP_SERVER_NAME}${colors.reset}   ${colors.muted}(interactive; command: npx -y ${MCP_PACKAGE})${colors.reset}`
  );
  console.log(
    `  Auto-config:  ${colors.accent}butter mcp install${colors.reset}   ${colors.muted}(OpenCode, Claude Desktop, Cursor)${colors.reset}`
  );
  console.log(`  Others:       ${MCP_DOCS_URL}`);
}

// os.homedir() honors $HOME on macOS and Linux, which is what lets the tests
// point every path below at a throwaway directory.
function mcpClients() {
  const home = os.homedir();
  let claudeDir;
  if (process.platform === "darwin") {
    claudeDir = path.join(home, "Library", "Application Support", "Claude");
  } else if (process.platform === "win32") {
    claudeDir = path.join(process.env.APPDATA || path.join(home, "AppData", "Roaming"), "Claude");
  } else {
    claudeDir = path.join(home, ".config", "Claude");
  }
  const opencodeDir = path.join(home, ".config", "opencode");
  const cursorDir = path.join(home, ".cursor");
  const claudeShape = { command: "npx", args: ["-y", MCP_PACKAGE] };

  return [
    {
      flag: "opencode",
      name: "OpenCode",
      dir: opencodeDir,
      // Either may exist; .jsonc wins when both do. A new file is plain JSON.
      files: [path.join(opencodeDir, "opencode.jsonc"), path.join(opencodeDir, "opencode.json")],
      createAs: path.join(opencodeDir, "opencode.json"),
      key: "mcp",
      entry: { type: "local", command: ["npx", "-y", MCP_PACKAGE], enabled: true }
    },
    {
      flag: "claude",
      name: "Claude Desktop",
      dir: claudeDir,
      files: [path.join(claudeDir, "claude_desktop_config.json")],
      createAs: path.join(claudeDir, "claude_desktop_config.json"),
      key: "mcpServers",
      entry: claudeShape
    },
    {
      flag: "cursor",
      name: "Cursor",
      dir: cursorDir,
      files: [path.join(cursorDir, "mcp.json")],
      createAs: path.join(cursorDir, "mcp.json"),
      key: "mcpServers",
      entry: claudeShape
    }
  ];
}

// Tolerant JSONC reader: strips // and /* */ comments and trailing commas
// (never inside strings), then hands the result to JSON.parse. Reports
// whether any comment was seen, because rewriting such a file would silently
// delete the user's comments.
function parseJsonc(text) {
  const src = text.charCodeAt(0) === 0xfeff ? text.slice(1) : text;
  let hadComments = false;

  // Index just past the string literal that starts at `i`.
  const skipString = (s, i) => {
    i++;
    while (i < s.length && s[i] !== '"') i += s[i] === "\\" ? 2 : 1;
    return i + 1;
  };

  let noComments = "";
  for (let i = 0; i < src.length; ) {
    const ch = src[i];
    if (ch === '"') {
      const end = skipString(src, i);
      noComments += src.slice(i, end);
      i = end;
    } else if (ch === "/" && src[i + 1] === "/") {
      hadComments = true;
      while (i < src.length && src[i] !== "\n") i++;
    } else if (ch === "/" && src[i + 1] === "*") {
      hadComments = true;
      const end = src.indexOf("*/", i + 2);
      if (end === -1) throw new SyntaxError("Unterminated /* comment");
      noComments += " ";
      i = end + 2;
    } else {
      noComments += ch;
      i++;
    }
  }

  let clean = "";
  for (let i = 0; i < noComments.length; ) {
    const ch = noComments[i];
    if (ch === '"') {
      const end = skipString(noComments, i);
      clean += noComments.slice(i, end);
      i = end;
      continue;
    }
    if (ch === ",") {
      let j = i + 1;
      while (j < noComments.length && /\s/.test(noComments[j])) j++;
      if (noComments[j] === "}" || noComments[j] === "]") {
        i++;
        continue;
      }
    }
    clean += ch;
    i++;
  }

  return { value: JSON.parse(clean), hadComments };
}

function isPlainObject(v) {
  return v !== null && typeof v === "object" && !Array.isArray(v);
}

// Key order means nothing to any client, so it must not make an existing,
// correct entry look stale.
function sameJson(a, b) {
  if (Array.isArray(a) || Array.isArray(b)) {
    return Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((v, i) => sameJson(v, b[i]));
  }
  if (isPlainObject(a) && isPlainObject(b)) {
    const keys = Object.keys(a);
    return keys.length === Object.keys(b).length && keys.every((k) => Object.hasOwn(b, k) && sameJson(a[k], b[k]));
  }
  return a === b;
}

function indent(text, pad) {
  return text
    .split("\n")
    .map((l) => pad + l)
    .join("\n");
}

// What to paste by hand. If the file already has the section, only the entry
// goes inside it; otherwise the whole section goes at the top level.
function printMcpSnippet(client, data) {
  const hasSection = isPlainObject(data) && isPlainObject(data[client.key]);
  const snippet = hasSection
    ? `"${MCP_SERVER_NAME}": ${JSON.stringify(client.entry, null, 2)}`
    : `"${client.key}": ${JSON.stringify({ [MCP_SERVER_NAME]: client.entry }, null, 2)}`;
  const where = hasSection ? `inside the existing "${client.key}" object` : "at the top level";
  console.log(`  Add this ${where} (with a comma if it is not the last entry):\n`);
  console.log(indent(snippet, "    "));
  console.log("");
}

// Returns "written", "unchanged", "manual" or "error".
function mcpInstallClient(client, { dryRun }) {
  const existing = client.files.find((f) => fs.existsSync(f));
  const file = existing || client.createAs;
  let data = {};
  let hadComments = false;

  if (existing) {
    const text = fs.readFileSync(existing, "utf-8");
    if (text.trim() !== "") {
      try {
        ({ value: data, hadComments } = parseJsonc(text));
      } catch (err) {
        console.error(`${colors.err}✗ ${client.name}: could not parse ${file}: ${err.message}${colors.reset}`);
        console.error(`  Left it untouched. Fix the file, or edit it by hand:`);
        printMcpSnippet(client, null);
        return "error";
      }
    }
  }

  if (!isPlainObject(data) || (data[client.key] !== undefined && !isPlainObject(data[client.key]))) {
    const what = isPlainObject(data) ? `"${client.key}" is not an object` : "the top level is not an object";
    console.error(`${colors.err}✗ ${client.name}: ${file}: ${what}. Left it untouched.${colors.reset}`);
    return "error";
  }

  const section = data[client.key] || {};
  const previous = section[MCP_SERVER_NAME];
  if (previous !== undefined && sameJson(previous, client.entry)) {
    console.log(`${colors.ok}✓ ${client.name}: already configured${colors.reset} ${colors.muted}(${file})${colors.reset}`);
    return "unchanged";
  }

  if (hadComments) {
    console.log(`${colors.warn}! ${client.name}: ${file} contains comments, which a rewrite would delete.${colors.reset}`);
    printMcpSnippet(client, data);
    return "manual";
  }

  // Spreading keeps every other key, and keeps an existing entry in place.
  const next = { ...data, [client.key]: { ...section, [MCP_SERVER_NAME]: client.entry } };

  if (dryRun) {
    console.log(`${colors.accent}~ ${client.name}: would ${existing ? "update" : "create"} ${file}${colors.reset}`);
    console.log(`    ${client.key}.${MCP_SERVER_NAME} = ${JSON.stringify(client.entry)}`);
    if (previous !== undefined) console.log(`    replacing ${JSON.stringify(previous)}`);
    return "unchanged";
  }

  fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.writeFileSync(file, JSON.stringify(next, null, 2) + "\n");
  console.log(`${colors.ok}✓ ${client.name}: ${existing ? "updated" : "created"} ${file}${colors.reset}`);
  if (previous !== undefined) {
    console.log(`  ${colors.muted}Replaced the previous "${MCP_SERVER_NAME}" entry: ${JSON.stringify(previous)}${colors.reset}`);
  }
  return "written";
}

async function mcpInstall(args) {
  const clients = mcpClients();
  const requested = clients.filter((c) => args[c.flag]);
  const dryRun = Boolean(args["dry-run"]);

  // A client counts as installed when its config directory exists, so a
  // fresh Cursor install with no mcp.json yet is still picked up.
  const targets = requested.length ? requested : clients.filter((c) => fs.existsSync(c.dir));
  if (targets.length === 0) {
    console.error(`${colors.err}✗ No supported AI client found (looked for OpenCode, Claude Desktop, Cursor).${colors.reset}`);
    console.error(`Pass --opencode, --claude or --cursor to create a config anyway, or see ${MCP_DOCS_URL}`);
    process.exit(1);
  }

  if (dryRun) console.log(`${colors.muted}Dry run: nothing will be written.${colors.reset}`);

  const results = targets.map((c) => ({ client: c, status: mcpInstallClient(c, { dryRun }) }));

  const written = results.filter((r) => r.status === "written").map((r) => r.client.name);
  if (written.length) {
    console.log(`\nRestart ${written.join(", ")} to load the ButterStack MCP server.`);
  }
  if (!loadCredentials()) {
    console.log(
      `${colors.muted}The MCP server uses your CLI login. Run ${colors.bold}butter auth login${colors.reset}${colors.muted} if you have not yet.${colors.reset}`
    );
  }

  if (results.some((r) => r.status === "error")) process.exit(1);
}

function printMcpHelp() {
  console.log(`
${colors.accent}${colors.bold}butter mcp${colors.reset}
Connect AI clients to the ButterStack MCP server (npx -y ${MCP_PACKAGE}).

${colors.bold}USAGE:${colors.reset}
  butter mcp install [--opencode] [--claude] [--cursor] [--dry-run]

With no client flag, every installed client is configured. A client flag
limits the install to that client, creating its config file if needed.
Re-running is safe: only the "${MCP_SERVER_NAME}" entry is ever written.

  --opencode   ~/.config/opencode/opencode.jsonc (or opencode.json)
  --claude     Claude Desktop's claude_desktop_config.json
  --cursor     ~/.cursor/mcp.json
  --dry-run    Show what would change without writing anything

A config file containing comments is never rewritten; the entry to paste
is printed instead.

Claude Code registers servers itself:
  claude mcp add ${MCP_SERVER_NAME} -- npx -y ${MCP_PACKAGE}

Docs: ${MCP_DOCS_URL}
`);
}

// Flags that are switches, never name/value pairs (#1938).
//
// The parser used to treat every `--flag` as taking a value whenever the next
// argv entry did not start with `-`. That is fine at the end of a line, but
// `butter builds investigate --json <build_id>` parsed as
// `json: "<build_id>"` with no positional left, so the command printed its
// usage error and exited 1 -- looking, from the caller's side, like `--json`
// silently produced no output while the plain form worked. Position in the
// command line must not change what a boolean flag means.
const BOOLEAN_FLAGS = new Set([
  "json",
  "help",
  "h",
  "pending",
  "verbose",
  "yes",
  "force",
  "no-color",
  "steps",
  "dry-run",
  "opencode",
  "claude",
  "cursor",
  "orphaned"
]);

// `--key=value` is always explicit, so it is honored for any key including
// the booleans above (`--json=false` is not special-cased: anything after `=`
// is taken literally, which is the same behavior every other key gets).
function parseArgs(rawArgs) {
  const parsed = { _: [] };
  for (let i = 0; i < rawArgs.length; i++) {
    const arg = rawArgs[i];
    if (arg.startsWith("--")) {
      const body = arg.substring(2);
      const eq = body.indexOf("=");
      if (eq !== -1) {
        parsed[body.substring(0, eq)] = body.substring(eq + 1);
      } else if (BOOLEAN_FLAGS.has(body)) {
        parsed[body] = true;
      } else if (i + 1 < rawArgs.length && !rawArgs[i + 1].startsWith("-")) {
        parsed[body] = rawArgs[++i];
      } else {
        parsed[body] = true;
      }
    } else if (arg.startsWith("-")) {
      const key = arg.substring(1);
      parsed[key] = true;
    } else {
      parsed._.push(arg);
    }
  }
  return parsed;
}

function printHelp() {
  console.log(`
${colors.accent}${colors.bold}ButterStack CLI (butter)${colors.reset}
Fast, scriptable command line interface for game pipelines.

${colors.bold}USAGE:${colors.reset}
  butter <command> [subcommand] [options]

${colors.bold}COMMANDS:${colors.reset}
  ${colors.accent}auth${colors.reset} login | whoami | logout    Authenticate via browser OAuth loopback
  ${colors.accent}projects${colors.reset} list | show <id>         View and inspect game projects
  ${colors.accent}tasks${colors.reset} list | create | update       Manage tasks, bugs, and backlog
  ${colors.accent}builds${colors.reset} list | show | investigate | investigation
                        Inspect CI/CD builds and AI failure investigations.
                        ${colors.bold}investigate${colors.reset} STARTS a paid AI analysis;
                        ${colors.bold}investigation${colors.reset} reads the result back for free.
  ${colors.accent}changes${colors.reset} list | show <id|commit>   Commits and changelists (git, Perforce, Lore).
                        ${colors.bold}show${colors.reset} takes a change id, or a build's commit
                        (SHA, p4-<n>, lore-<n>) to find the change it belongs to.
                        list filters: --source lore|git|perforce, --since <date>,
                        --identifier <x>, --orphaned, --limit <n>, --after <cursor>
  ${colors.accent}assets${colors.reset} list | approve | deny        Review and approve textures, models, and audio
                        ${colors.bold}show${colors.reset} is coming soon
  ${colors.accent}mcp${colors.reset} install                     Connect OpenCode, Claude Desktop, and Cursor
                        to the ButterStack MCP server (see: butter mcp)

${colors.bold}GLOBAL OPTIONS:${colors.reset}
  --project <id>       Target project ID (e.g. --project 1)
  --host <url>         ButterStack API host (default: https://www.butterstack.com)
  --token <token>      Explicit API token override
  --json               Output machine-readable JSON
  --help, -h           Show this help message

${colors.bold}AUTH OPTIONS:${colors.reset}
  --scope <name|list>  Request less than the full permission set on login.
                        Presets: read-only. Or a raw space/comma-separated
                        list, e.g. --scope read:projects,read:builds
                        (default: the full CLI scope set)

Tokens expire 90 days after issue; ${colors.bold}butter auth whoami${colors.reset} shows the
remaining lifetime and ${colors.bold}butter auth login${colors.reset} again renews it.
The ${colors.bold}changes${colors.reset} commands need the read:changes scope; a token issued before
they shipped does not have it, so run ${colors.bold}butter auth login${colors.reset} again once.
`);
}

async function main() {
  const args = parseArgs(process.argv.slice(2));
  cliArgs = args; // see getHost() -- makes --host visible to request() everywhere
  const cmd = args._[0];
  const subcmd = args._[1];

  if ((args.help || args.h) && cmd === "mcp") {
    printMcpHelp();
    return;
  }
  if (args.help || args.h || !cmd) {
    printHelp();
    return;
  }

  switch (cmd) {
    case "auth":
      if (subcmd === "login") return authLogin(args);
      if (subcmd === "whoami" || subcmd === "status") return authWhoami(args);
      if (subcmd === "logout") return authLogout();
      break;
    case "projects":
    case "project":
      if (subcmd === "list" || !subcmd) return projectsList(args);
      if (subcmd === "show") return projectsShow(args);
      break;
    case "tasks":
    case "task":
      if (subcmd === "list" || !subcmd) return tasksList(args);
      if (subcmd === "create") return tasksCreate(args);
      break;
    case "builds":
    case "build":
      if (subcmd === "list" || !subcmd) return buildsList(args);
      if (subcmd === "show") return buildsShow(args);
      if (subcmd === "investigate") return buildsInvestigate(args);
      if (subcmd === "investigation") return buildsInvestigation(args);
      break;
    case "changes":
    case "change":
      if (subcmd === "list" || !subcmd) return changesList(args);
      if (subcmd === "show") return changesShow(args);
      break;
    case "assets":
    case "asset":
      if (subcmd === "list" || !subcmd) return assetsList(args);
      if (subcmd === "approve") return assetsApprove(args);
      if (subcmd === "deny") return assetsDeny(args);
      break;
    case "mcp":
      if (!subcmd) return printMcpHelp();
      if (subcmd === "install") return mcpInstall(args);
      break;
    default:
      console.error(`${colors.err}Unknown command: ${cmd}${colors.reset}`);
      printHelp();
      process.exit(1);
  }

  // Reaching here means the command matched but its subcommand did not, and
  // every branch above `break`s rather than returning. That used to fall out
  // of main() silently: `butter builds show <id>` printed nothing and exited
  // 0, which reads as "this build has no data" rather than "this subcommand
  // does not exist" (#1938). An unhandled subcommand is an error.
  console.error(`${colors.err}Unknown subcommand: ${cmd} ${subcmd || ""}${colors.reset}`.trimEnd());
  printHelp();
  process.exit(1);
}

if (require.main === module) {
  main().catch((err) => {
    console.error(`${colors.err}Error: ${err.message}${colors.reset}`);
    process.exit(1);
  });
}

module.exports = { request, loadCredentials, saveCredentials, getHost, parseJsonc };
